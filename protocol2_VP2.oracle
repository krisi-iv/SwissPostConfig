#!/usr/bin/python3

import re
import os
import sys
debug = True

lines = sys.stdin.readlines()
l1 = []
l2 = []
l3 = []
l4 = []
l5 = []
l6 = []
lemma = sys.argv[1]

# INPUT:
# - lines contain a list of "%i:goal" where "%i" is the index of the goal
# - lemma contain the name of the lemma under scrutiny
# OUTPUT:
# - (on stdout) a list of ordered index separated by EOL


for line in lines:
	num = line.split(':')[0]
	if "executability" in lemma:
		print ("applying oracle to "+lemma)
		if 'State_' in line  or '!KU( ~pp' in line or '!KU( ~s1' in line or '!KU( ~s3' in line or '!KU( ~EL' in line or '!KU( ~s2' in line or '!KU( ~s4' in line or '!KU( ~s5' in line or 'Keystore_' in line or '!KU( ~ltk' in line or '!Ltk_' in line or '!KU( ~pi' in line  or '!KU( ~kid' in line or '~~>' in line:
			l1.append(num)
		elif '!KU( sign(<pp_' in line or '!KU( sign(<s3_' in line or '!KU( sign(<' in line or 'Out_' in line:
			l2.append(num)
		elif '!KU( SchnorrProof(' in line or '!KU( ~csk' in line or '!KU( ~elsk' in line or '!KU( ~exp' in line:
			l6.append(num)
		elif '!KU( h(' in line or '!KU( pk(h(' in line or '!KU( pow(aenc(' in line or '!KU( aenc(' in line:
			l4.append(num)
		elif '!KU( GenExpProof(' in line:
			l5.append(num)
	elif "but_fails_check" in lemma or "S6_correctness" in lemma or "SX_correctness" in lemma or "Vcard" in lemma or "PP_correctness" in lemma or 'S7' in lemma:
		print ("applying oracle to "+lemma)
		if 'State_' in line or '!KU( ~pp' in line or '!KU( ~s1' in line or '!KU( ~s3' in line or '!KU( ~EL' in line or '!KU( ~s2' in line or '!KU( ~s4' in line or '!KU( ~s5' in line or 'Keystore_' in line or '!KU( ~ltk' in line or '!Ltk_' in line or '!KU( ~pi' in line  or '!KU( ~kid' in line:
			l1.append(num)
		elif '!KU( sign(<pp_' in line or '!KU( sign(<s3_' in line or '!KU( sign(<' in line or 'Out_' in line:
			l2.append(num)
		elif '!KU( ~csk' in line or '!KU( ~elsk' in line or '!KU( ~exp' in line:
			l3.append(num)
		elif '!KU( h(' in line or '!KU( pk(h(' in line or '!KU( pow(aenc(' in line or '!KU( aenc(' in line:
			l4.append(num)
		elif '!KU( SchnorrProof(' in line or '!KU( GenExpProof(' in line:
			l5.append(num)
	elif "S3_correctness" in lemma:
		print ("applying oracle to "+lemma)
		if 'Keystore_' in line or '!KU( ~ltk' in line  or '!KU( ~pp' in line  or '!KU( ~svk' in line:
			l1.append(num)
		elif '!KU( sign(<pp_' in line or '!KU( sign(<x, h' in line: 
			l2.append(num)
		elif '!Ltk_' in line or 'State_' in line:
			l3.append(num)
	elif "S1_correctness_CC" in lemma:
		print ("applying oracle to "+lemma)
		if '!KU( ~ltkSCS' in line  or '!KU( ~pp' in line  or '!KU( ~svk' in line:
			l1.append(num)
		elif '!KU( ~ltk' in line:
			l2.append(num)
		elif '!KU( sign(<pp_' in line or '!KU( sign(<' in line: 
			l3.append(num)
		elif '!Ltk_' in line or 'State_' in line:
			l4.append(num)
	elif "S1_correctness_Verif" in lemma:
		print ("applying oracle to "+lemma)
		if 'State_' in line or 'Out_' in line or '!KU( ~pp' in line or '!KU( ~s1' in line or '!KU( ~s3' in line or '!KU( ~EL' in line or '!KU( ~s2' in line or '!KU( ~s4' in line or '!KU( ~s5' in line or 'Keystore_' in line or '!KU( ~ltk' in line or '!Ltk_' in line or '!KU( ~pi' in line  or '!KU( ~kid' in line:
			l1.append(num)
		elif '!KU( sign(<pp_' in line or '!KU( sign(<s3_' in line or '!KU( sign(<' in line:
			l2.append(num)
		elif '!KU( ~csk' in line or '!KU( ~elsk' in line or '!KU( ~exp' in line:
			l3.append(num)
		elif '!KU( h(' in line or '!KU( pk(h(' in line or '!KU( pow(aenc(' in line or '!KU( aenc(' in line:
			l4.append(num)
		elif '!KU( SchnorrProof(' in line or '!KU( GenExpProof(' in line:
			l5.append(num)
	else:
		print ("applying standard heuristic to "+lemma)
		exit(0)		

# Ordering all goals by ranking (higher first)
ranked=l1+l2+l3+l4+l5+l6
for goal in ranked:
	print (goal)
